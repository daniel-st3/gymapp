<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Little Lift</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>littlelift</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>The optional motion experiment uses a workout session for wrist-down execution; it does not read your Health history.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Allow a temporary workout session for the optional motion experiment. Little Lift does not save a Health workout.</string>
	<key>NSMotionUsageDescription</key>
	<string>Optional experimental wrist timing replay, processed only on your devices.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(LITTLELIFT_PHONE_BUNDLE_ID)</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<key>WKWatchOnly</key>
	<false/>
</dict>
</plist>
