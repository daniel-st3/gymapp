          "stringUnit": {
            "state": "translated",
            "value": "La rotación de muñeca no mide peso ni certifica técnica. Las repeticiones son estimaciones editables que debes confirmar. No se han validado continuidad con muñeca bajada, consumo ni precisión."
          }
        }
      }
