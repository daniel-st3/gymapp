    "No previous conversation is assumed. Missing values are unknown. Keep variation, units and load conventions matched. No causal, injury-risk or medical-readiness conclusions. Any proposed plan requires my acceptance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous conversation is assumed. Missing values are unknown. Keep variation, units and load conventions matched. No causal, injury-risk or medical-readiness conclusions. Any proposed plan requires my acceptance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se presupone ninguna conversación previa. Los valores ausentes son desconocidos. Compara solo la misma variante, unidad y convención de carga. No infieras causas, riesgo de lesión ni aptitud médica. Cualquier propuesta de plan requiere mi aceptación."
          }
        }
      }
    },
