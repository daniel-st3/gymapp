    "Only finished Little Lift sessions with at least one logged set are counted. Early finishes count the work actually logged. Weeks start on Monday in your current time zone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only finished Little Lift sessions with at least one logged set are counted. Early finishes count the work actually logged. Weeks start on Monday in your current time zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo sesiones finalizadas en Little Lift con trabajo registrado, sin prácticas. Finalizar antes cuenta únicamente lo realizado. Las semanas del gráfico empiezan el lunes en tu zona horaria actual."
          }
        }
      }
    },
    "Typical session is the median time from Start to Finish, including breaks. It is not active exercise or measured rest. Zero-length and over-six-hour sessions are excluded from this estimate ({0} in this range).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typical session is the median time from Start to Finish, including breaks. It is not active exercise or measured rest. Zero-length and over-six-hour sessions are excluded from this estimate ({0} in this range)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duración habitual es la mediana entre Iniciar y Finalizar, incluidas las pausas. No es ejercicio activo ni descanso medido. Se excluyen duraciones de cero o superiores a seis horas ({0} en este periodo)."
          }
        }
      }
    },
