    "Monday–Sunday. A completed workout with recorded work counts once per day. Practice and imported records do not count. Rest days are allowed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monday–Sunday. A completed workout with recorded work counts once per day. Practice and imported records do not count. Rest days are allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De lunes a domingo. Una sesión finalizada con trabajo registrado cuenta una vez por día. Las prácticas y registros importados no cuentan. Puedes descansar entre días."
          }
        }
      }
    },
    "Your time zone is fixed when you enable the goal. Later changes start next Monday; previous weeks keep their rule. Paused weeks preserve continuity without earning a week.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time zone is fixed when you enable the goal. Later changes start next Monday; previous weeks keep their rule. Paused weeks preserve continuity without earning a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona horaria queda fijada al activar la meta. Los cambios posteriores empiezan el próximo lunes. Las semanas pausadas conservan la continuidad sin sumar una semana."
          }
        }
      }
    },
