          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Watch: … → Prueba de movimiento → Iniciar. Permite el acceso de Apple y toca Detener. La grabación se envía al iPhone automáticamente; Enviar permite reintentar. Máximo 3 minutos."
          }
        }
      }
