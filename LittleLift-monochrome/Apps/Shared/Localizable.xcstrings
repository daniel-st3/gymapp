    },
    "Use only when no other workout app is recording. A temporary HealthKit workout provides background runtime and may affect system activity measurements. Little Lift does not save a Health workout or read Health history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
