          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita prioridades y aprueba trabajo opcional en Rutinas. En el Watch, abre Ajustar entreno para revisar una versión corta. Solo se omite trabajo opcional sin empezar, después del actual. No cambia carga, repeticiones ni descanso requerido."
          }
        }
      }
